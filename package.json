{
  "name": "byteevolvr-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"frontend,shop,admin,backend\" -c \"blue,green,magenta,yellow\" \"npm run dev -w @byteevolvr/frontend\" \"npm run dev -w @byteevolvr/shop\" \"npm run dev -w @byteevolvr/admin\" \"npm run dev -w @byteevolvr/backend\"",
    "dev:frontend": "npm run dev --workspace @byteevolvr/frontend",
    "dev:shop": "npm run dev --workspace @byteevolvr/shop",
    "dev:admin": "npm run dev --workspace @byteevolvr/admin",
    "dev:backend": "npm run dev --workspace @byteevolvr/backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
