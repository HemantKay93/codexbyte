FROM node:20-slim AS build
WORKDIR /usr/src/app

# Install dependencies first for caching
COPY package.json package-lock.json ./
COPY apps/frontend/package.json ./apps/frontend/
COPY apps/admin/package.json ./apps/admin/
COPY packages/ui/package.json ./packages/ui/
COPY packages/store/package.json ./packages/store/
COPY packages/api-client/package.json ./packages/api-client/
COPY backend/package.json ./backend/
RUN npm ci

# Copy full source and build
COPY . .

# Pass in env variables at build time so Vite can embed them into the static files
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_BASE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Build both frontends
RUN npm run build -w @byteevolvr/frontend
RUN npm run build -w @byteevolvr/admin

# Stage 2: Serve via Nginx
FROM nginx:alpine
# Copy built static files
COPY --from=build /usr/src/app/apps/frontend/dist /usr/share/nginx/html/frontend
COPY --from=build /usr/src/app/apps/admin/dist /usr/share/nginx/html/admin
# Copy custom Nginx routing config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 81
CMD ["nginx", "-g", "daemon off;"]
